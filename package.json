{
  "name": "cineadapt-backend",
  "version": "1.0.0",
  "description": "API REST de CineAdapt",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "jest --runInBand",
    "test:unit": "jest tests/unit",
    "test:integration": "jest --runInBand tests/integration",
    "test:coverage": "jest --runInBand --coverage",
    "lint": "eslint src",
    "test:wb": "jest --runInBand tests/whitebox"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.3.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^15.15.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.4",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup-env.js"
    ],
    "collectCoverageFrom": [
      "src/controllers/auth.controller.js",
      "src/controllers/watchlist.controller.js",
      "src/controllers/reports.controller.js",
      "src/controllers/messages.controller.js",
      "src/middleware/auth.js",
      "src/app.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "modulePathIgnorePatterns": []
  }
}